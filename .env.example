# Copy to `.env` and fill in. `.env` is bundled as a Flutter asset and is
# readable by anyone who unzips the APK/IPA — never put a private key here.
APP_NAME=
BASE_URL=
ENABLE_NETWORK_LOGS=false
CONNECT_TIMEOUT_MS=30000
RECEIVE_TIMEOUT_MS=30000
# Realtime (Pusher protocol). The app key is public; never put the secret here.
# Leave PUSHER_APP_KEY or PUSHER_HOST blank to run without realtime.
PUSHER_APP_KEY=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=wss
